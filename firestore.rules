rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // A self-created profile may only carry the empty default subscription;
    // any plan or credits must come from a payment through the Admin SDK.
    function isEmptyDefaultSubscription(sub) {
      return sub.get('planId', null) == null
          && sub.get('status', 'expired') == 'expired'
          && sub.get('classesRemaining', 0) == 0
          && sub.get('introCreditRemaining', 0) == 0
          && sub.get('guestPassesRemaining', 0) == 0;
    }

    // Users collection
    // - Read: owner can read own profile; admin can read all (for member management)
    // - Create: authenticated users can create their own profile
    // - Update: only the owner can update their own profile (non-subscription fields)
    // - Subscription and stats fields are updated by Cloud Functions (Admin SDK bypasses rules)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny(['isFoundingMember', 'foundingWaitlistId', 'role'])
                    && (!('subscription' in request.resource.data)
                        || isEmptyDefaultSubscription(request.resource.data.subscription));
      // Members edit their own profile, never their entitlements. Plans and
      // credits are written only by API routes and Cloud Functions (Admin SDK).
      allow update: if isOwner(userId)
                    && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['subscription', 'isFoundingMember', 'foundingWaitlistId', 'stats', 'role']);

      // Expo push tokens, one document per device.
      // - The owner registers and removes their own device tokens.
      // - The push fan-out function reads and prunes them with the Admin SDK,
      //   which bypasses these rules.
      match /pushTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Classes collection
    // - Read: any authenticated user can browse classes
    // - Write: admin only (via Cloud Functions with Admin SDK)
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Bookings collection
    // - Read: owner can read their own bookings; admin can read all
    // - Create/Update/Delete: handled exclusively by Cloud Functions (Admin SDK)
    // - Client-side writes are blocked to ensure transactional integrity
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Payments collection
    // - Read: owner can read their own payments; admin can read all
    // - Write: handled exclusively by API routes (Admin SDK bypasses rules)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Trainers collection
    // - Read: any authenticated user
    // - Write: admin only
    match /trainers/{trainerId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Gym Centers (single facility)
    // - Read: public (for marketing/info pages)
    // - Write: admin only
    match /gymCenters/{gymId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Subscription Plans
    // - Read: public (for pricing page)
    // - Write: admin only
    match /subscriptionPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Intro class leads (public form submissions)
    // - Create: anyone (unauthenticated form submissions allowed)
    // - Read/Update/Delete: admin only
    match /introClassLeads/{leadId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'phone'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string;
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Waitlist (founding membership interest)
    // - Create: anyone (no auth required)
    // - Read/Update/Delete: admin only
    match /waitlist/{entryId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email'])
                    && request.resource.data.name is string
                    && request.resource.data.phone is string
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // Admins collection
    // - Read/Write: admin only
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Notifications collection
    // - Read: owner only (admins read via the Admin SDK, not the client)
    // - Create/Delete: blocked; written by scheduled functions and admin API routes
    // - Update: owner may only flip their own notification to read
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, delete: if false;
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['read', 'readAt']);
    }

    // Push delivery tickets
    // - Written and pruned exclusively by the push fan-out and receipt jobs
    //   (Admin SDK bypasses rules). They hold no member-facing data, so no
    //   client ever needs to read them.
    match /pushTickets/{ticketId} {
      allow read, write: if false;
    }

    // Subscription ledger
    // - Append-only history of every change to users/{uid}.subscription.
    // - Written only by API routes and Cloud Functions (Admin SDK); read by
    //   admins through /api/admin/members/events. Never client-writable.
    match /subscriptionEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Feedback collection (public form submissions)
    // - Create: anyone (unauthenticated form submissions allowed)
    // - Read/Update/Delete: admin only
    match /feedback/{docId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'rating'])
                    && request.resource.data.name is string
                    && request.resource.data.message is string
                    && request.resource.data.rating is int;
      allow read, update, delete: if isAdmin();
    }

    // Contact form messages (website /contact page)
    // - Create: server only via /api/contact (Admin SDK). Never client-writable.
    // - Read/Update/Delete: admin only
    match /contactMessages/{messageId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }
  }
}
