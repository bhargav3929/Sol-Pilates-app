NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Razorpay (test keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
# Razorpay webhook secret — Settings → Webhooks in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Trainer booking alerts via Resend. RESEND_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM="Sol Pilates Studio <bookings@solpilatesstudio.in>"
# Inbox that receives website contact form messages (defaults to solpilatesstudio.in@gmail.com)
CONTACT_NOTIFY_EMAIL=

# Meta Pixel ID from Events Manager. Leave empty to disable the pixel.
NEXT_PUBLIC_META_PIXEL_ID=
